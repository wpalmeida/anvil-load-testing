# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=loadtest
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/loadtest

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- InfluxDB v1 ---
# Defaults to the bundled influxdb container in docker-compose. To point at
# your own existing InfluxDB v1 instance, change to e.g.
# http://192.168.1.10:8086/k6 (the worker has host.docker.internal mapped if
# you want to reach a host running on the same machine).
INFLUXDB_DB=k6
INFLUXDB_URL=http://influxdb:8086/k6

# --- Grafana ---
# Defaults to the bundled grafana container. Override to point at your own.
GRAFANA_BASE_URL=http://localhost:3000
GRAFANA_DASHBOARD_UID=anvil

# Default admin login for the bundled Grafana. Anonymous access is also
# enabled (Editor role) so devs can land on the dashboard without a login.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- API ---
API_PORT=4000

# --- Safety guards (all optional — empty = no limit) ---
# Comma-separated list of allowed target hostnames. Each entry is either an
# exact hostname or a *.suffix wildcard. If unset/empty, ANY host is allowed.
# Examples: api.example.com,*.internal.example.com
TARGET_HOST_ALLOWLIST=

# Maximum peak VUs across any run (rejects on POST /runs and rerun).
MAX_VUS=1000

# Maximum total duration in seconds (rejects on POST /runs and rerun).
MAX_DURATION_SECONDS=3600

# Maximum number of simultaneously queued+running tests.
MAX_CONCURRENT_RUNS=5

# --- Web ---
VITE_API_URL=http://localhost:4000
